<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the bridge running after login. Edit the paths, then:
     cp launchd/com.drawthings.bridge.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.drawthings.bridge.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.drawthings.bridge</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/cloud-to-mac-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file=.env</string>
    <string>dist/index.js</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/drawthings-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/drawthings-bridge.log</string>
</dict>
</plist>
