# Copy to .env and fill in. Never commit .env.

# Secret that must appear in the connector URL path: https://<host>/mcp/<BRIDGE_TOKEN>
# Generate one with: npm run gen-token
BRIDGE_TOKEN=

# Where the bridge listens. Keep it on 127.0.0.1; cloudflared connects locally.
HOST=127.0.0.1
PORT=8787

# Draw Things HTTP API server (Settings > API Server in the app, HTTP mode)
DRAWTHINGS_URL=http://127.0.0.1:7860

# Full-size PNGs are saved here on the Mac
OUTPUT_DIR=./outputs

# Inline preview sent back to Claude (JPEG). Keeps results under connector size limits.
PREVIEW_MAX_SIDE=1024
PREVIEW_JPEG_QUALITY=82

# Per-generation timeout in seconds
GENERATION_TIMEOUT_S=600
